{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "playwright.config.ts",
    "e2e/support/**/*.ts",
    "e2e/support/assert-live-results.mjs",
    "test/unit/browser-security.test.ts"
  ]
}
